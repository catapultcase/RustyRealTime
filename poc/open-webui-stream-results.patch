+// A sentence ends at . ! ? or … (optionally followed by closing quotes, brackets or emphasis) before whitespace,
+// or at a line break, which also ends a list item or heading.
+const SENTENCE_END = /[.!?\u2026]["'\u201d\u2019)\]*_]*(?=\s)|\n/g;
+
+/**
+ * The part of a streaming answer that may be spoken before the turn completes.
+ *
+ * Only text after the turn's last tool call can be the answer: text followed by a tool call is the model
+ * narrating its work. The trailing text is released once it holds `minSentences` complete sentences, so a
+ * one-line preamble that turns out to precede another tool call is never spoken. Returns the trailing text
+ * up to its last complete sentence, or '' while it is held.
+ */
+export function getStreamableText(output: any[] | null | undefined, minSentences: number): string {
+	const items = output ?? [];
+	let start = 0;
+	items.forEach((item, index) => {
+		if (item?.type === 'function_call' || item?.type === 'function_call_output') start = index + 1;
+	});
+	const text = getOutputText(items.slice(start));
+	const ends = [...text.matchAll(SENTENCE_END)]
+		.map((match) => match.index! + match[0].length)
+		.filter((end) => text.slice(0, end).trim());
+	return ends.length >= minSentences ? text.slice(0, ends[ends.length - 1]) : '';
+}
