+	/** Send the newly complete sentences of a still-streaming answer to the provider. */
+	private streamResult(turn: VoiceTurn, message: any) {
+		if (!this.streamResults || turn.streamClosed) return;
+		const text = getStreamableText(message?.output, this.streamResults.min_sentences);
+		const sent = turn.streamed ?? '';
+		if (sent && !text.startsWith(sent)) {
+			// The streamed text was followed by a tool call. The provider has what it spoke; the final
+			// result carries everything after it.
+			turn.streamClosed = true;
+			return;
+		}
+		if (text.length <= sent.length) return;
+		turn.streamed = text;
+		this.send({ type: 'bridge.result.delta', call_id: turn.callId, delta: text.slice(sent.length) });
+	}
