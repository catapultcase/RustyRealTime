+/**
+ * Text that may be spoken while the turn streams: only text after the latest tool call, minus the last
+ * `lookaheadBytes`. Narration just before a tool call is followed only by the call, so it is never released.
+ * Bytes, not sentences: no punctuation rules, and scripts count alike.
+ */
+export function getStreamableText(output: any[] | null | undefined, lookaheadBytes: number): string {
+	const items = output ?? [];
+	let start = 0;
+	items.forEach((item, index) => {
+		if (item?.type === 'function_call' || item?.type === 'function_call_output') start = index + 1;
+	});
+	const bytes = new TextEncoder().encode(getOutputText(items.slice(start)));
+	// stream: true drops a character cut in half instead of decoding it as U+FFFD.
+	return new TextDecoder().decode(bytes.subarray(0, Math.max(0, bytes.length - lookaheadBytes)), {
+		stream: true
+	});
+}
